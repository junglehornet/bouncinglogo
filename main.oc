package main;

import "time";
import "os/exec";
import "term";
import "unicode";
import "io";
import "strings";
import "os";
import "unicode/utf8";
import "term/tui";

struct Model {
    logos [][]string;
    selected int;
    width, height int;
    x, y int;
    vx int : 3; // -2 or 2
    vy int : 2; // -1 or 1
    tickms int;
}

struct Tick {}

func (m *Model) updateSize() {
    m.height = len(m.logos[m.selected]);
    x := 0;
    runes := utf8.Runes(m.logos[m.selected][0]);
    for (i := 0; i < len(runes); i++) {
        r := runes[i];
        for (r == '\033') {
            r = runes[i++];
            for (r != 'm') {
                if (i >= len(runes)) { io.Println("Error parsing ANSI escape codes: newline encountered while parsing escape code."); os.Exit(-1); }
                r = runes[i++];
            }
            if (i >= len(runes)) break;
            r = runes[i];
        }
        if (unicode.IsPrint(r)) x++; // this just counts how many *printable* characters there are, not how wide each one is, so non-standard width chars will break this.
    }
    m.width = x;
}

func newModel() Model {
    m: Model; // m is zero-initialized so we don't need to set x and y to 0
    m.x = 0;
    m.y = 0;
    m.vx = 2;
    m.vy = 1;
    m.tickms = 200;
    for (i := 1; i <= 4; i++) {
        logoFull := os.Open(io.Sprintf("logo{}.ansi", i).unwrap(), os.FileMode.Read).unwrap().Readall().unwrap()[:]->string;
        logoSplit := strings.Split(logoFull, "\n");
        m.logos.append(logoSplit);
    }
    m.selected = 0;
    m.updateSize();
    return m;
}

func (m Model) View() string {
    str := "";
    size := term.GetSize(os.Stdin().unwrap()).unwrap();
    for (y := 0; y < size.Height; y++) {
        for (x := 0; x < size.Width; x++) {
            if (offset := y - m.y; x == m.x && offset >= 0 && offset < m.height) {
                str += m.logos[m.selected][offset];
                x += m.width - 1;
            } else {
                str += " ";
            }
        }
        str += "\n";
    }
    return str[:len(str) - 1]; // remove trailing newline
}

func (m Model) Update(message tui.Msg) (tui.Model, tui.Cmd) {
    switch (event := message.(type)) {
        case tui.KeyMsg:
            if (event.Alt) goto nop;
            if (event.Key == "ctrl+c" || event.Text == "q") return m, tui.Quit;
            if (event.Key == "up" && m.tickms > 50) m.tickms -= 50;
            if (event.Key == "down" && m.tickms < 1000) m.tickms += 50;
            if (event.Key == "left") {
                m.selected -= 1;
                for (m.selected < 0) m.selected += len(m.logos);
                m.updateSize();
                return m, tui.NoCmd;
            }
            if (event.Key == "right") {
                m.selected = (m.selected + 1) % len(m.logos);
                m.updateSize();
                return m, tui.NoCmd;
            }
        case Tick:
            size := term.GetSize(os.Stdin().unwrap()).unwrap();

            maxX := size.Width - m.width;
            if (maxX < 0) maxX = 0;
            m.x += m.vx;
            if (m.x > maxX) {
                m.x = maxX - (m.x - maxX == 1 ? 3 : 2);
                m.vx = -2;
            } else if (m.x < 0) {
                m.x = 2;
                m.vx = 2;
            }

            maxY := size.Height - m.height;
            if (maxY < 0) maxY = 0;
            m.y += m.vy;
            if (m.y > maxY) {
                m.y = maxY - 1;
                m.vy = -1;
            } else if (m.y < 0) {
                m.y = 1;
                m.vy = 1;
            }

            return m, tui.Tick(m.tickms * time.Millisecond, Tick{});
    }
    nop:
    return m, tui.NoCmd;
}

func (m Model) Init() tui.Cmd {
    return tui.Tick(m.tickms * time.Millisecond, Tick{});
}

func main() {
    p := tui.NewProgram(newModel(), tui.Options{AltScreen: true});
    p.Run();
}
